<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="StockifyWeb.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Stockify</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Stockify CSS -->
    <link href="Content/Stockify.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- ================= NAVBAR ================= -->
        <nav class="navbar navbar-expand-lg stockify-navbar">
            <div class="container d-flex justify-content-between align-items-center">
                <!-- Logo -->
                <a class="navbar-brand stockify-logo d-flex align-items-center gap-2" href="Default.aspx">
                    <span class="logo-icon">📊</span>
                    STOCKIFY
                </a>

                <!-- Center Navigation -->
                <div class="stockify-center-nav d-none d-lg-flex gap-4">
                    <a href="Default.aspx" class="stockify-nav-link active">Home</a>
                    <a href="Features.aspx" class="stockify-nav-link">Feature</a>
                </div>

                <!-- Right Action Buttons -->
                <div class="stockify-right-actions d-flex gap-2">
                    <a href="Login.aspx" class="btn btn-stockify-dark">Login</a>
                    <a href="Register.aspx" class="btn btn-stockify-dark">Register</a>
                </div>
            </div>
        </nav>

        <!-- ================= MAIN CONTENT ================= -->
        <main>
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <!-- ================= FOOTER ================= -->
        <footer class="stockify-footer">
            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-4 col-md-6 brand-col">
                        <div class="footer-logo d-flex align-items-center gap-2 mb-3">
                            <span class="logo-icon text-white">📊</span>
                            <h4>Stockify</h4>
                        </div>
                        <p class="footer-desc">
                            Sophisticated inventory intelligence for modern retail operations. Precision engineered for scale.
                        </p>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <h5 class="footer-heading">Product</h5>
                        <ul class="footer-links">
                            <li><a href="#">Features</a></li>
                            <li><a href="#">API Docs</a></li>
                            <li><a href="#">Integrations</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <h5 class="footer-heading">Company</h5>
                        <ul class="footer-links">
                            <li><a href="#">About Us</a></li>
                            <li><a href="#">Careers</a></li>
                            <li><a href="#">Contact</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <h5 class="footer-heading">Legal</h5>
                        <ul class="footer-links">
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Terms of Service</a></li>
                        </ul>
                        <div class="social-icons mt-3">
                            <a href="#">Share</a>
                            <a href="#">Tweet</a>
                            <a href="#">Link</a>
                        </div>
                    </div>
                </div>

                <div class="footer-bottom mt-5 pt-3 border-top border-secondary">
                    <p class="mb-0 text-muted">&copy; <%: DateTime.Now.Year %> Stockify Intelligence Inc. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </form>
</body>
</html>